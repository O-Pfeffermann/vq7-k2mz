ygon","coordinates":[[[13.530061,42.092885],[13.531457,42.08964],[13.533856,42.087951],[13.53585,42.087437],[13.541481,42.087599],[13.546684,42.088636],[13.552381,42.088812],[13.555757,42.089291],[13.567521,42.088867],[13.573068,42.090195],[13.576417,42.091888],[13.577415,42.093023],[13.577575,42.09431],[13.575986,42.09606],[13.575807,42.097247],[13.579766,42.104457],[13.58126,42.11012],[13.581534,42.113492],[13.580023,42.118954],[13.575002,42.125433],[13.57034,42.127612],[13.568428,42.127936],[13.566546,42.127744],[13.564945,42.126995],[13.563891,42.125664],[13.56373,42.124902],[13.564424,42.120058],[13.571203,42.106434],[13.57116,42.102404],[13.570113,42.099519],[13.569573,42.099015],[13.567572,42.098731],[13.546601,42.098654],[13.542341,42.099797],[13.540073,42.099732],[13.535702,42.098755],[13.533185,42.097541],[13.530761,42.095309],[13.530061,42.092885]]]}},{"type":"Feature","id":"coast-cerrano","properties":{"zone":"Coast","kind":"group","name":"Pineto / Torre di Cerrano / Atri / Città Sant'Angelo oval","photos":["05-coast-north-pineto-pescara-chieti.jpg"],"confidence":"high","notes":"Large oval from Casoli/Atri in the west to well out over the sea in the east (it includes the handwritten 'TORRE DI CERRANO' and its arrow to the tower) and south to Città Sant'Angelo. The north-west edge (Casoli - Mutignano - Pineto) is a thin stroke placed by eye; along the south-east arc near Silvi/A14 there are two strokes and the outer one was used. Atri and Città Sant'Angelo also have their own small circles (separate 'mark' features); 'CALANCHI' is handwritten below Atri with an arrow.","label_point":[14.06155,42.56169]},"geometry":{"type":"Polygon","coordinates":[[[13.93143,42.58129],[13.931081,42.580652],[13.931027,42.578191],[13.93123,42.577457],[13.932667,42.575722],[13.932744,42.575007],[13.930772,42.566079],[13.931079,42.56131],[13.931944,42.557204],[13.933312,42.554623],[13.933805,42.552178],[13.935297,42.549817],[13.946094,42.540857],[13.948008,42.54015],[13.953461